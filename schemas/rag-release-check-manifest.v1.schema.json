{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AliZahiri/ai-rag-platform-blueprint/schemas/rag-release-check-manifest.v1.schema.json",
  "title": "RAG release-check manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checks"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "gate": {
            "type": "string",
            "enum": [
              "chat-retention",
              "citation-freshness",
              "index-replica-consistency",
              "litellm-preflight",
              "vector-backup"
            ]
          },
          "args": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      }
    }
  }
}
